{
  "name": "ip-switcher",
  "version": "1.0.1",
  "description": "IP Switcher - Gestor de perfiles de red",
  "author": {
    "name": "Paulo Carrasco",
    "url": "https://paulocarrasco.dev"
  },
  "homepage": "./",
  "main": "electron/main.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && set ELECTRON_START_URL=http://localhost:3000&&electron .\"",
    "selftest": "node scripts/selftest.cjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist-portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "dev.paulocarrasco.ipswitcher",
    "productName": "IP Switcher",
    "copyright": "Copyright © 2026 Paulo Carrasco — paulocarrasco.dev",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IP Switcher"
    }
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
